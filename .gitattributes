# Normalise line endings; keep binaries binary.
* text=auto eol=lf

*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sln    text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.rc     text eol=crlf
*.manifest text eol=crlf

*.ico   binary
*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
