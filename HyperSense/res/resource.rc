#include <windows.h>

1 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,1
 PRODUCTVERSION 1,0,1,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HYPERSENSEGLOBAL"
            VALUE "FileDescription", "HyperSense - Live Usermode Memory Analysis Tool (x64)"
            VALUE "FileVersion", "1.0.1.1"
            VALUE "InternalName", "HyperSense64"
            VALUE "LegalCopyright", "Copyright (C) 2026 HYPERSENSEGLOBAL. Moneta engine (C) Forrest Orr & Gabriel Landau, GPLv3."
            VALUE "LegalTrademarks", "HYPERSENSEGLOBAL(TM)"
            VALUE "OriginalFilename", "HyperSense64.exe"
            VALUE "ProductName", "HYPERSENSEGLOBAL HyperSense"
            VALUE "ProductVersion", "1.0.1.1"
            VALUE "Comments", "Live usermode memory analysis front-end for the open-source Moneta engine (GPLv3). Reads only the process the user selects and writes only the report the user saves. https://github.com/hypersenseindia/hypersense-memory-analyzer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
