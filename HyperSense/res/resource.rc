            VALUE "ProductName", "HYPERSENSEGLOBAL V1"
            VALUE "ProductVersion", "1.0.1.0"
            VALUE "LegalCopyright", "Engine (C) Forrest Orr & Gabriel Landau - GPLv3 | Front-end by AG HYDRAXFF"
            VALUE "LegalTrademarks", "HYPERSENSEGLOBAL"
            VALUE "Comments", "Usermode memory analysis front-end for the open-source Moneta engine (github.com/forrest-orr/moneta, GPLv3). Dev: @hydraxff_yt"
        END
    END
    BLOCK "VarFileInfo"
